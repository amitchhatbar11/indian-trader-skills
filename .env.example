# Copy to ~/.nse-desk/.env and fill in what you use. Environment variables
# override these. Never commit the real file.

# ── Fyers (quotes, 1/5-minute bars, SPAN margin) — then: desk login fyers ──
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=

# ── Upstox (quotes, bars) — the day's access token ──
UPSTOX_ACCESS_TOKEN=

# ── Zerodha Kite Connect (quotes; bars need the historical add-on) ──
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── ICICI Breeze (bars only) — the day's apisession value ──
BREEZE_API_KEY=
BREEZE_SESSION=

# Feed order; brokers without credentials are skipped.
DESK_FEEDS=fyers,upstox,zerodha,breeze

# ── Paper account and limits (written to ~/.nse-desk/config.json on first use) ──
DESK_CAPITAL=1000000
DESK_RISK_PCT=0.5          # max loss per trade, % of capital
DESK_DAILY_LOSS_PCT=1      # daily loss limit, % of capital
DESK_MAX_SPREAD_PCT=5      # widest bid-ask spread for an option entry

# ── Optional: alerts to your own Telegram bot (desk alerts check -telegram) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
